# Copy this file to .env.local for Mac host-based n8n runs.
# Keep .env.local local-only; it is gitignored on purpose.

# Public URL exposed through cloudflared / reverse proxy
N8N_HOST=n8n.seunghyun.space
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.seunghyun.space
WEBHOOK_URL=https://n8n.seunghyun.space/
N8N_PROXY_HOPS=1

# Local listener
N8N_PORT=5678
N8N_LISTEN_ADDRESS=127.0.0.1

# Enable Execute Command while keeping Local File Trigger blocked by default
NODES_EXCLUDE='["n8n-nodes-base.localFileTrigger"]'

# Workspace paths
N8N_CUSTOM_EXTENSIONS=/Users/seunghyun.ko/Documents/Git_Project/n8n_server/custom
N8N_USER_FOLDER=/Users/seunghyun.ko/Documents/Git_Project/n8n_server/local/n8n-user
# Important: n8n stores data in "$N8N_USER_FOLDER/.n8n", not directly in N8N_USER_FOLDER.
# If you are reusing a previous Docker-mounted folder that already contains database.sqlite/config/nodes,
# point N8N_USER_FOLDER at a parent folder and make its ".n8n" entry resolve to that existing folder.
# Example:
# N8N_USER_FOLDER=/Users/seunghyun.ko/Documents/n8n-data-home
# ln -s /Users/seunghyun.ko/Documents/n8n-data /Users/seunghyun.ko/Documents/n8n-data-home/.n8n

# Timezone
TZ=Asia/Seoul
GENERIC_TIMEZONE=Asia/Seoul

# Optional hardening / convenience
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
DB_TYPE=sqlite

# Optional explicit executable paths when you want them in the process env
# CODEX_CLI_PATH=/opt/homebrew/bin/codex

# Optional cloudflared overrides
# CLOUDFLARED_CONFIG_FILE=/Users/seunghyun.ko/.cloudflared/config.yml
# CLOUDFLARED_TUNNEL_NAME=n8n
