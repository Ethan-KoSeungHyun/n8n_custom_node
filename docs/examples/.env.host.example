# Shared custom node path
# Windows example:
# N8N_CUSTOM_EXTENSIONS=D:/Project/N8N_SERVER/n8n_custom_node/custom
# macOS example:
# N8N_CUSTOM_EXTENSIONS=/Users/you/N8N_SERVER/n8n_custom_node/custom
# Linux example:
# N8N_CUSTOM_EXTENSIONS=/srv/N8N_SERVER/n8n_custom_node/custom

# Allow custom nodes to read needed env vars
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Keep Execute Command available when your workflows need it
NODES_EXCLUDE=[]

# Optional when codex is not on PATH
# Windows example:
# CODEX_CLI_PATH=C:/Users/you/AppData/Local/Programs/codex/codex.cmd
# macOS example:
# CODEX_CLI_PATH=/opt/homebrew/bin/codex
# Linux example:
# CODEX_CLI_PATH=/usr/local/bin/codex

# Optional corporate CA bundle
# NODE_EXTRA_CA_CERTS=/absolute/path/to/company-ca.pem
