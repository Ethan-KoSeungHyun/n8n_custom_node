# 공용 커스텀 노드 경로
# Windows 예시:
# N8N_CUSTOM_EXTENSIONS=D:/Project/N8N_SERVER/n8n_server_github/custom
# Linux 예시:
# N8N_CUSTOM_EXTENSIONS=/srv/N8N_SERVER/n8n_server_github/custom

# 커스텀 노드가 필요한 환경 변수를 읽을 수 있도록 허용
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# 필요한 경우 Execute Command 노드를 계속 사용할 수 있도록 유지
NODES_EXCLUDE=[]

# 선택 사항: 호스트 로컬 Codex 상태 경로
# Windows 예시:
# CODEX_HOME=D:\Project\N8N_SERVER\data\codex-home
# Linux 예시:
# CODEX_HOME=/var/lib/n8n/codex-home

# 선택 사항: codex가 PATH에 없을 때
# Windows 예시:
# CODEX_BINARY_PATH=C:/Users/you/AppData/Local/Programs/codex/codex.exe
# Linux 예시:
# CODEX_BINARY_PATH=/usr/local/bin/codex

# 선택 사항: 사내 CA 번들 경로
# NODE_EXTRA_CA_CERTS=/absolute/path/to/company-ca.pem
