# Shared custom node path
# Windows example:
# N8N_CUSTOM_EXTENSIONS=D:/Project/N8N_SERVER/n8n_server_github/custom
# Linux example:
# N8N_CUSTOM_EXTENSIONS=/srv/N8N_SERVER/n8n_server_github/custom

# Allow custom nodes to read needed env vars
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Keep Execute Command available when your workflows need it
NODES_EXCLUDE=[]

# Optional host-local Codex state
# Windows example:
# CODEX_HOME=D:\Project\N8N_SERVER\data\codex-home
# Linux example:
# CODEX_HOME=/var/lib/n8n/codex-home

# Optional when codex is not on PATH
# Windows example:
# CODEX_CLI_PATH=C:/Users/you/AppData/Local/Programs/codex/codex.cmd
# Linux example:
# CODEX_CLI_PATH=/usr/local/bin/codex

# Optional corporate CA bundle
# NODE_EXTRA_CA_CERTS=/absolute/path/to/company-ca.pem
